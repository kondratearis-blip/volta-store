# Страницы: на своём домене Cloudflare сам вставляет в HTML счётчик посещений (Web Analytics),
# а строгий CSP его всё равно запрещает — в консоли ошибки. no-transform запрещает менять страницу
# по пути к покупателю; остальное — как Cloudflare и Netlify отдают HTML по умолчанию
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

