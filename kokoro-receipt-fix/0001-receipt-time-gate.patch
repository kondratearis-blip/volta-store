+  const shown = await json(browser, `({ paid: document.querySelector('.ord[data-id="2"] .ord__paid')?.textContent || '',
+    summary: document.querySelector('.ord[data-id="2"] .chk summary')?.textContent.trim() || '',
+    rows: [...document.querySelectorAll('.ord[data-id="2"] .chk__rows dt')].map((dt) => dt.textContent + ': ' + dt.nextElementSibling.textContent) })`);
